  "memories": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "text": "修改检索算分后，提交前必须运行 python -m pytest tests/utils/test_scoring.py -q。",
      "user_id": "user-a",
      "space_id": "space-alpha"
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "text": "提交前运行 uv run ruff check . 检查代码规范。",
      "user_id": "user-a",
      "space_id": "space-alpha"
    },
    {
      "id": "00000000-0000-0000-0000-000000000003",
      "text": "提交前运行 uv run mypy 检查静态类型。",
      "user_id": "user-a",
      "space_id": "space-alpha"
    },
    {
      "id": "00000000-0000-0000-0000-000000000004",
      "text": "部署前运行 uv run python config/manage.py check --deploy。",
      "user_id": "user-a",
      "space_id": "space-alpha"
    },
    {
      "id": "00000000-0000-0000-0000-000000000005",
      "text": "CLI 只能恢复当前工作区中的 Conversation。",
      "user_id": "user-a",
      "space_id": "space-alpha"
    },
    {
      "id": "00000000-0000-0000-0000-000000000006",
      "text": "每个新 Turn 都会自动召回当前 User 的 User Memory，以及当前 Memory Space 的 Space Memory。",
      "user_id": "user-a",
      "space_id": "space-alpha"
    },
    {
      "id": "00000000-0000-0000-0000-000000000007",
      "text": "用户偏好简洁回答。",
      "user_id": "user-a",
      "space_id": null
    },
    {
      "id": "00000000-0000-0000-0000-000000000008",
      "text": "用户偏好先给结论，再解释原因。",
      "user_id": "user-a",
      "space_id": null
    },
    {
      "id": "00000000-0000-0000-0000-000000000009",
      "text": "支持工单 ticket-4821 的状态是等待客户确认。",
      "user_id": "user-a",
      "space_id": "space-alpha"
    },
    {
      "id": "00000000-0000-0000-0000-000000000010",
      "text": "This repository uses Ruff as its Python formatter and linter.",
      "user_id": "user-a",
      "space_id": "space-alpha"
    },
    {
      "id": "00000000-0000-0000-0000-000000000011",
      "text": "这个前端项目提交前运行 npm test。",
