    },
    {
      "id": "00000000-0000-0000-0000-000000000013",
      "text": "用户偏好详细、长篇的回答。",
      "user_id": "user-b",
      "space_id": null
    },
    {
      "id": "00000000-0000-0000-0000-000000000014",
      "text": "Conversation metadata is stored in SQLite.",
